{% extends 'admin/base.html.twig' %}

{% block title %}Modération des missions | GNUT 06{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/01-core.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/02-components.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/admin/mission-list/01-overview.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/admin/mission-list/02-filters.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/admin/mission-list/03-statuses.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/admin/mission-list/04-table.css') }}">
{% endblock %}

{% block body %}
{% set totalMissions = missions|length %}
{% set modalityLabels = {'distance': 'À distance', 'sur_place': 'Sur place', 'hybride': 'Hybride'} %}

<div class="admin-mission-page">
    <div class="dashboard-container">
        <header class="page-header">
            <div>
                <span class="page-badge"><i class="bi bi-shield-lock" aria-hidden="true"></i> Administration GNUT06</span>
                <h1 class="page-title">Modération des missions</h1>
                <p class="page-description">Consultez les missions déposées par les entreprises, examinez les demandes en attente et suivez leur publication sur GNUT06.</p>
            </div>
            <div class="header-info">
                <div class="header-info-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></div>
                <div>
                    <div class="header-info-label">Missions enregistrées</div>
                    <div class="header-info-value">{{ totalMissions }} au total</div>
                </div>
            </div>
        </header>

        {% for message in app.flashes('success') %}
            <div class="flash-message flash-success" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>{{ message }}</span></div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
            <div class="flash-message flash-warning" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>{{ message }}</span></div>
        {% endfor %}

        <section class="stats-grid" aria-label="Statistiques des missions">
            <article class="stat-card stat-total">
                <div class="stat-header"><span class="stat-label">Total des missions</span><span class="stat-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span></div>
                <div class="stat-value">{{ totalMissions }}</div>
                <p class="stat-description">Toutes les missions enregistrées</p>
            </article>
            <article class="stat-card stat-pending">
                <div class="stat-header"><span class="stat-label">En attente</span><span class="stat-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span></div>
                <div class="stat-value">{{ pendingCount }}</div>
                <p class="stat-description">Missions à examiner</p>
            </article>
            <article class="stat-card stat-published">
                <div class="stat-header"><span class="stat-label">Publiées</span><span class="stat-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span></div>
                <div class="stat-value">{{ publishedCount }}</div>
                <p class="stat-description">Missions actuellement publiées</p>
            </article>
            <article class="stat-card stat-correction">
                <div class="stat-header"><span class="stat-label">À corriger</span><span class="stat-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span></div>
                <div class="stat-value">{{ correctionCount }}</div>
                <p class="stat-description">Missions retournées aux entreprises</p>
            </article>
        </section>

        <section class="content-card" aria-labelledby="missions-list-title">
            <div class="content-header">
                <div>
                    <h2 class="content-title" id="missions-list-title"><i class="bi bi-list-task" aria-hidden="true"></i> Liste des missions</h2>
                    <p class="content-description">Retrouvez les missions et accédez aux dossiers de modération.</p>
                </div>
                <span class="result-count" data-results-count role="status" aria-live="polite" aria-atomic="true">{{ totalMissions }} résultat{{ totalMissions > 1 ? 's' : '' }}</span>
            </div>
            <div class="toolbar">
                <div class="search-wrapper">
                    <label for="mission-search" class="visually-hidden">Rechercher une mission</label>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="mission-search" class="search-input" placeholder="Mission, entreprise, domaine..." autocomplete="off" data-mission-search>
                </div>
                <div class="filter-group" aria-label="Filtrer les missions">
                    <button type="button" class="filter-button active" data-mission-filter="all" aria-pressed="true">Toutes</button>
                    <button type="button" class="filter-button" data-mission-filter="en_attente" aria-pressed="false">En attente</button>
                    <button type="button" class="filter-button" data-mission-filter="publiee" aria-pressed="false">Publiées</button>
                    <button type="button" class="filter-button" data-mission-filter="a_corriger" aria-pressed="false">À corriger</button>
                    <button type="button" class="filter-button" data-mission-filter="other" aria-pressed="false">Autres statuts</button>
                </div>
            </div>

            {% if missions is empty %}
                <div class="empty-state"><div class="empty-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></div><h3 class="empty-title">Aucune mission enregistrée</h3><p class="empty-description">Les missions déposées par les entreprises apparaîtront ici dès leur création.</p></div>
            {% else %}
                <div class="missions-table-wrap">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mission-table">
                            <caption class="visually-hidden">Liste des missions avec leur entreprise, statut et accès au dossier de modération.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Mission</th>
                                    <th scope="col">Entreprise</th>
                                    <th scope="col">Domaine</th>
                                    <th scope="col">Modalité</th>
                                    <th scope="col">Date limite</th>
                                    <th scope="col">Statut</th>
                                    <th scope="col">Date de dépôt</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for mission in missions %}
                                    {% set statusLabel = statusLabels[mission.statut] ?? mission.statut %}
                                    <tr data-mission-row data-status="{{ mission.statut }}">
                                        <td>
                                            <span class="mission-title">{{ mission.titre ?: 'Mission sans titre' }}</span>
                                            {% if mission.description %}<span class="mission-table-excerpt">{{ mission.description|striptags|slice(0, 100) }}{% if mission.description|striptags|length > 100 %}…{% endif %}</span>{% endif %}
                                        </td>
                                        <td>{{ mission.compteEntreprise.raisonSociale }}</td>
                                        <td>{{ mission.domaine ?: '—' }}</td>
                                        <td>{{ modalityLabels[mission.modalite] ?? (mission.modalite ?: '—') }}</td>
                                        <td class="text-nowrap">{{ mission.dateLimiteReponse ? mission.dateLimiteReponse|date('d/m/Y') : '—' }}</td>
                                        <td><span class="status-badge status-{{ mission.statut }}"><i class="bi bi-circle-fill" aria-hidden="true"></i>{{ statusLabel }}</span></td>
                                        <td class="text-nowrap">{{ mission.submittedAt ? mission.submittedAt|date('d/m/Y') : mission.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            <a href="{{ path('admin_mission_show', {'id': mission.id}) }}" class="mission-action" aria-label="{{ mission.statut == 'en_attente' ? 'Examiner' : 'Consulter' }} la mission {{ mission.titre ?: 'sans titre' }}">
                                                <i class="bi {{ mission.statut == 'en_attente' ? 'bi-clipboard-check' : 'bi-eye' }}" aria-hidden="true"></i>
                                                {{ mission.statut == 'en_attente' ? 'Examiner' : 'Consulter' }}
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="empty-state" data-no-results hidden>
                    <div class="empty-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
                    <h3 class="empty-title">Aucun résultat</h3>
                    <p class="empty-description">Aucune mission ne correspond à votre recherche. Essayez un autre mot-clé ou modifiez le filtre.</p>
                </div>
            {% endif %}
        </section>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const page = document.querySelector('.admin-mission-page');
    if (!page) return;
    const searchInput = page.querySelector('[data-mission-search]');
    const filterButtons = Array.from(page.querySelectorAll('[data-mission-filter]'));
    const missionRows = Array.from(page.querySelectorAll('[data-mission-row]'));
    const resultsCount = page.querySelector('[data-results-count]');
    const noResults = page.querySelector('[data-no-results]');
    let activeFilter = 'all';

    function normalizeText(value) {
        return value.toLocaleLowerCase('fr').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function updateMissions() {
        const query = searchInput ? normalizeText(searchInput.value.trim()) : '';
        let visibleCount = 0;
        missionRows.forEach(function (row) {
            const status = row.dataset.status;
            const matchesStatus = activeFilter === 'all' ||
                (activeFilter === 'other' ? !['en_attente', 'publiee', 'a_corriger'].includes(status) : status === activeFilter);
            const visible = matchesStatus && normalizeText(row.textContent).includes(query);
            row.hidden = !visible;
            if (visible) visibleCount++;
        });
        if (resultsCount) resultsCount.textContent = visibleCount + ' résultat' + (visibleCount > 1 ? 's' : '');
        if (noResults) noResults.hidden = visibleCount > 0;
    }

    filterButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            activeFilter = button.dataset.missionFilter;
            filterButtons.forEach(function (item) {
                const isActive = item === button;
                item.classList.toggle('active', isActive);
                item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
            updateMissions();
        });
    });
    if (searchInput) searchInput.addEventListener('input', updateMissions);
    updateMissions();
});
</script>
{% endblock %}