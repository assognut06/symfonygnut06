{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des comptes entreprises | GNUT 06{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin_company.css') }}">
{% endblock %}

{% block body %}

{% set totalAccounts = accounts|length %}
{% set totalPending = 0 %}
{% set totalApproved = 0 %}
{% set totalRejected = 0 %}
{% set totalSuspended = 0 %}

{% for account in accounts %}
    {% if account.statut == 'pending' %}
        {% set totalPending = totalPending + 1 %}
    {% elseif account.statut == 'approved' %}
        {% set totalApproved = totalApproved + 1 %}
    {% elseif account.statut == 'rejected' %}
        {% set totalRejected = totalRejected + 1 %}
    {% elseif account.statut == 'suspended' %}
        {% set totalSuspended = totalSuspended + 1 %}
    {% endif %}
{% endfor %}

<div class="admin-company-page">

    <div class="admin-container">

        <header class="page-header">

            <div>

                <span class="page-badge">
                    <i class="bi bi-shield-lock"></i>
                    Administration GNUT06
                </span>

                <h1 class="page-title">
                    Comptes entreprises
                </h1>

                <p class="page-description">
                    Consultez les entreprises inscrites sur la plateforme,
                    suivez leurs demandes et gérez la validation
                    de leurs comptes professionnels.
                </p>

            </div>

            <div class="header-indicator">

                <div class="header-indicator-icon">
                    <i class="bi bi-buildings"></i>
                </div>

                <div>

                    <div class="header-indicator-label">
                        Entreprises inscrites
                    </div>

                    <div class="header-indicator-value">
                        {{ totalAccounts }} au total
                    </div>

                </div>

            </div>

        </header>

        {% for message in app.flashes('success') %}

            <div class="flash-message flash-success" role="status">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ message }}</span>
            </div>

        {% endfor %}

        {% for message in app.flashes('warning') %}

            <div class="flash-message flash-warning" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <span>{{ message }}</span>
            </div>

        {% endfor %}

        <section class="stats-grid" aria-label="Statistiques des comptes entreprises">

            <article class="stat-card stat-pending">

                <div class="stat-header">

                    <span class="stat-label">
                        En attente
                    </span>

                    <span class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </span>

                </div>

                <div class="stat-value">
                    {{ totalPending }}
                </div>

                <p class="stat-description">
                    Demandes à examiner
                </p>

            </article>

            <article class="stat-card stat-approved">

                <div class="stat-header">

                    <span class="stat-label">
                        Approuvées
                    </span>

                    <span class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </span>

                </div>

                <div class="stat-value">
                    {{ totalApproved }}
                </div>

                <p class="stat-description">
                    Entreprises validées
                </p>

            </article>

            <article class="stat-card stat-rejected">

                <div class="stat-header">

                    <span class="stat-label">
                        Refusées
                    </span>

                    <span class="stat-icon">
                        <i class="bi bi-x-circle"></i>
                    </span>

                </div>

                <div class="stat-value">
                    {{ totalRejected }}
                </div>

                <p class="stat-description">
                    Demandes non approuvées
                </p>

            </article>

            <article class="stat-card stat-suspended">

                <div class="stat-header">

                    <span class="stat-label">
                        Suspendues
                    </span>

                    <span class="stat-icon">
                        <i class="bi bi-shield-x"></i>
                    </span>

                </div>

                <div class="stat-value">
                    {{ totalSuspended }}
                </div>

                <p class="stat-description">
                    Comptes actuellement suspendus
                </p>

            </article>

        </section>

        <section class="content-card" aria-labelledby="accounts-title">

            <div class="content-header">

                <div>

                    <h2 class="content-title" id="accounts-title">
                        <i class="bi bi-building-check"></i>
                        Liste des entreprises
                    </h2>

                    <p class="content-description">
                        Retrouvez les comptes entreprises et consultez
                        les dossiers nécessitant une intervention.
                    </p>

                </div>

                <span class="result-counter" data-results-count role="status" aria-live="polite" aria-atomic="true">
                    {{ totalAccounts }}
                    résultat{{ totalAccounts > 1 ? 's' : '' }}
                </span>

            </div>

            <div class="toolbar">

                <div class="search-wrapper">

                    <label for="company-search" class="visually-hidden">
                        Rechercher une entreprise
                    </label>

                    <i class="bi bi-search"></i>

                    <input
                        type="search"
                        id="company-search"
                        class="search-input"
                        placeholder="Entreprise, contact, e-mail, SIREN..."
                        autocomplete="off"
                        data-company-search
                    >

                </div>

                <div class="filter-group" aria-label="Filtrer les entreprises">

                    <button
                        type="button"
                        class="filter-button active"
                        data-company-filter="all"
                        aria-pressed="true"
                    >
                        Toutes
                    </button>

                    <button
                        type="button"
                        class="filter-button"
                        data-company-filter="pending"
                        aria-pressed="false"
                    >
                        En attente
                    </button>

                    <button
                        type="button"
                        class="filter-button"
                        data-company-filter="approved"
                        aria-pressed="false"
                    >
                        Approuvées
                    </button>

                    <button
                        type="button"
                        class="filter-button"
                        data-company-filter="rejected"
                        aria-pressed="false"
                    >
                        Refusées
                    </button>

                    <button
                        type="button"
                        class="filter-button"
                        data-company-filter="suspended"
                        aria-pressed="false"
                    >
                        Suspendues
                    </button>

                </div>

            </div>

            {% if accounts is empty %}

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <h3 class="empty-title">
                        Aucune entreprise inscrite
                    </h3>

                    <p class="empty-description">
                        Aucun compte entreprise n'a encore été créé.
                        Les nouvelles demandes apparaîtront ici
                        dès leur enregistrement.
                    </p>

                </div>

            {% else %}

                <div class="accounts-table-wrap">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle company-table">
                            <caption class="visually-hidden">
                                Comptes entreprises inscrits sur GNUT06. Utilisez la recherche et les filtres pour affiner les résultats.
                            </caption>
                            <thead>
                                <tr>
                                    <th scope="col">Entreprise</th>
                                    <th scope="col">Contact</th>
                                    <th scope="col">E-mail</th>
                                    <th scope="col">Identifiant légal</th>
                                    <th scope="col">Inscription</th>
                                    <th scope="col">Statut</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for account in accounts %}
                                    {% set statusLabel = statusLabels[account.statut] ?? account.statut %}
                                    <tr data-company-row data-status="{{ account.statut }}">
                                        <td>
                                            <span class="company-name">{{ account.raisonSociale }}</span>
                                        </td>
                                        <td>{{ account.nomContact }}</td>
                                        <td>
                                            <span class="company-email">{{ account.emailContact }}</span>
                                        </td>
                                        <td>
                                            {% if account.identifiantLegal %}
                                                {{ account.identifiantLegal }}
                                            {% else %}
                                                <span class="text-muted-company">Non renseigné</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-nowrap">{{ account.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            <span class="status-badge status-{{ account.statut }}">
                                                <i class="bi bi-circle-fill" aria-hidden="true"></i>
                                                {{ statusLabel }}
                                            </span>
                                        </td>
                                        <td>
                                            <a
                                                href="{{ path('admin_company_show', {'id': account.id}) }}"
                                                class="view-button"
                                                aria-label="Consulter le dossier de {{ account.raisonSociale }}"
                                            >
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                                Consulter
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div
                    class="empty-state"
                    data-no-results
                    hidden
                >

                    <div class="empty-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3 class="empty-title">
                        Aucun résultat
                    </h3>

                    <p class="empty-description">
                        Aucune entreprise ne correspond à votre recherche.
                        Essayez un autre nom ou modifiez les filtres.
                    </p>

                </div>

            {% endif %}

        </section>

    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const page = document.querySelector('.admin-company-page');

    if (!page) {
        return;
    }

    const searchInput = page.querySelector('[data-company-search]');
    const filterButtons = Array.from(
        page.querySelectorAll('[data-company-filter]')
    );
    const companyRows = Array.from(
        page.querySelectorAll('[data-company-row]')
    );
    const resultsCount = page.querySelector('[data-results-count]');
    const noResults = page.querySelector('[data-no-results]');

    let activeFilter = 'all';

    function normalizeText(value) {
        return value
            .toLocaleLowerCase('fr')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function updateCompanies() {
        const query = normalizeText(searchInput.value.trim());
        let visibleCount = 0;

        companyRows.forEach(function (row) {
            const matchesStatus =
                activeFilter === 'all' ||
                row.dataset.status === activeFilter;

            const matchesSearch =
                normalizeText(row.textContent).includes(query);

            const shouldShow = matchesStatus && matchesSearch;

            row.hidden = !shouldShow;

            if (shouldShow) {
                visibleCount++;
            }
        });

        if (resultsCount) {
            resultsCount.textContent =
                visibleCount +
                ' résultat' +
                (visibleCount > 1 ? 's' : '');
        }

        if (noResults) {
            noResults.hidden = visibleCount > 0;
        }
    }

    filterButtons.forEach(function (button) {
        button.addEventListener('click', function () {
            activeFilter = button.dataset.companyFilter;

            filterButtons.forEach(function (item) {
                const isActive = item === button;

                item.classList.toggle('active', isActive);
                item.setAttribute(
                    'aria-pressed',
                    isActive ? 'true' : 'false'
                );
            });

            updateCompanies();
        });
    });

    if (searchInput) {
        searchInput.addEventListener('input', updateCompanies);
    }

    updateCompanies();
});
</script>

{% endblock %}