<script>
document.addEventListener('DOMContentLoaded', function () {
    const page = document.querySelector('.mission-form-page');

    if (!page) {
        return;
    }

    const select = page.querySelector('[data-skill-select]');
    const selectedList = page.querySelector('[data-selected-skill-list]');
    const selectedCount = page.querySelector('[data-selected-skill-count]');
    const emptyMessage = page.querySelector('[data-selected-skill-empty]');

    if (!select || !selectedList || !selectedCount || !emptyMessage) {
        return;
    }

    function updateSelectedCompetences() {
        const selectedOptions = Array.from(select.selectedOptions);

        selectedList.replaceChildren();

        selectedCount.textContent =
            selectedOptions.length +
            ' sélectionnée' +
            (selectedOptions.length > 1 ? 's' : '');

        emptyMessage.hidden = selectedOptions.length > 0;

        selectedOptions.forEach(function (option) {
            const tag = document.createElement('span');
            tag.className = 'selected-skill-tag';

            const label = document.createElement('span');
            label.textContent = option.textContent.trim();

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'selected-skill-remove';
            removeButton.textContent = '×';

            removeButton.setAttribute(
                'aria-label',
                'Retirer la compétence ' + option.textContent.trim()
            );

            removeButton.addEventListener('click', function () {
                option.selected = false;

                select.dispatchEvent(
                    new Event('change', {
                        bubbles: true
                    })
                );
            });

            tag.appendChild(label);
            tag.appendChild(removeButton);

            selectedList.appendChild(tag);
        });
    }

    select.addEventListener('change', updateSelectedCompetences);

    updateSelectedCompetences();
});
</script>

