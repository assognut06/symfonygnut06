{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} | GNUT 06{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/01-core.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/02-components.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-form/01-overview.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-form/02-form.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-form/03-fields.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-form/04-skills.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-form/05-actions.css') }}">
{% endblock %}

{% block body %}


<main class="mission-form-page">

    <div class="form-container">

        <a href="{{ path('entreprise_mission_index') }}" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Retour à mes missions
        </a>

        <header class="page-header">

            <span class="page-label">
                <i class="bi bi-briefcase"></i>
                Espace entreprise
            </span>

            <h1 class="page-title">
                {{ pageTitle }}
            </h1>

            <p class="page-description">
                Renseignez les informations de votre mission.
                Vous pouvez enregistrer un brouillon et revenir
                le compléter avant de le soumettre à validation.
            </p>

        </header>

        {% if lastCorrection is defined and lastCorrection %}
            <section class="mission-correction-notice" aria-labelledby="mission-correction-title">
                <div class="mission-correction-icon" aria-hidden="true">
                    <i class="bi bi-pencil-square"></i>
                </div>

                <div class="mission-correction-content">
                    <div class="mission-correction-header">
                        <h2 id="mission-correction-title" class="mission-correction-title">
                            Votre mission est à corriger
                        </h2>
                        <span class="mission-correction-badge">Action requise</span>
                    </div>

                    <p class="mission-correction-intro">
                        L'équipe GNUT06 a demandé quelques ajustements avant la publication de votre mission.
                        Consultez son retour, puis modifiez les informations concernées.
                    </p>

                    <div class="mission-correction-reason">
                        <p class="mission-correction-reason-label">Retour de l'équipe GNUT06</p>
                        <p class="mission-correction-reason-text">{{ lastCorrection.reason }}</p>
                    </div>

                    <p class="mission-correction-date">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        <span>Demande du <time datetime="{{ lastCorrection.createdAt|date('c') }}">{{ lastCorrection.createdAt|date('d/m/Y à H:i') }}</time></span>
                    </p>
                </div>
            </section>
        {% endif %}

        {{ form_start(form, {
            'attr': {
                'class': 'mission-entry-form'
            }
        }) }}

        {% if not form.vars.valid %}

            <div class="form-global-errors" role="alert">
                Veuillez corriger les erreurs signalées dans le formulaire.
                {{ form_errors(form) }}
            </div>

        {% else %}

            {{ form_errors(form) }}

        {% endif %}

        <div class="form-layout">

            <div class="form-main">

                <section class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <div>
                            <h2 class="section-title">
                                Présentation de la mission
                            </h2>

                            <p class="section-description">
                                Décrivez clairement le travail attendu.
                            </p>
                        </div>

                    </div>

                    <div class="field-group">

                        {{ form_label(form.titre, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        {{ form_widget(form.titre, {
                            'attr': {
                                'class': 'mission-control',
                                'placeholder': 'Ex. Développement d’un site internet',
                                'aria-describedby': 'mission-help-titre'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.titre) }}
                        </div>

                        <p class="field-help" id="mission-help-titre">
                            Choisissez un titre clair et précis.
                            Maximum 120 caractères.
                        </p>

                    </div>

                    <div class="field-group">

                        {{ form_label(form.description, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        {{ form_widget(form.description, {
                            'attr': {
                                'class': 'mission-control',
                                'placeholder': 'Décrivez les objectifs, les tâches à réaliser et les résultats attendus.',
                                'aria-describedby': 'mission-help-description'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.description) }}
                        </div>

                        <p class="field-help" id="mission-help-description">
                            Maximum 3 000 caractères.
                            Ne mentionnez aucune donnée personnelle
                            ou information sensible.
                        </p>

                    </div>

                </section>

                <section class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-stars"></i>
                        </div>

                        <div>
                            <h2 class="section-title">
                                Compétences et localisation
                            </h2>

                            <p class="section-description">
                                Précisez le profil recherché et les modalités d'intervention.
                            </p>
                        </div>

                    </div>

                    <div class="field-group">

                        {{ form_label(form.competences, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        <div class="selected-skills-box">

                            <div class="selected-skills-header">

                                <h3 class="selected-skills-title">
                                    <i class="bi bi-check2-circle"></i>
                                    Compétences sélectionnées
                                </h3>

                                <span
                                    class="selected-skills-count"
                                    data-selected-skill-count
                                >
                                    0 sélectionnée
                                </span>

                            </div>

                            <div
                                class="selected-skills-list"
                                data-selected-skill-list
                                aria-live="polite"
                                aria-relevant="additions removals"
                            ></div>

                            <p
                                class="selected-skills-empty"
                                data-selected-skill-empty
                            >
                                Aucune compétence sélectionnée pour le moment.
                            </p>

                        </div>

                        <span class="skills-selector-label">
                            Sélectionnez les compétences recherchées :
                        </span>

                        {{ form_widget(form.competences, {
                            'attr': {
                                'class': 'mission-control',
                                'data-skill-select': '1',
                                'aria-describedby': 'mission-help-skills'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.competences) }}
                        </div>

                        <div class="skills-hint" id="mission-help-skills">
                            <i class="bi bi-info-circle"></i>
                            <span>
                                Maintenez Ctrl sur Windows ou Cmd sur Mac
                                pour sélectionner plusieurs compétences.
                                Vous pouvez retirer une compétence en cliquant
                                sur la croix de son étiquette.
                            </span>
                        </div>

                        {% if form.competences.vars.choices is empty %}

                            <div class="sidebar-alert mt-3" role="status">
                                <i class="bi bi-exclamation-circle"></i>
                                Aucune compétence n'est disponible
                                dans le référentiel pour le moment.
                            </div>

                        {% endif %}

                    </div>

                    <div class="field-group">

                        {{ form_label(form.domaine, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        {{ form_widget(form.domaine, {
                            'attr': {
                                'class': 'mission-control',
                                'placeholder': 'Ex. Informatique, communication, gestion'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.domaine) }}
                        </div>

                    </div>

                    <div class="field-grid">

                        <div class="field-group">

                            {{ form_label(form.zone, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.zone, {
                                'attr': {
                                    'class': 'mission-control',
                                    'placeholder': 'Ex. Île-de-France'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.zone) }}
                            </div>

                        </div>

                        <div class="field-group">

                            {{ form_label(form.modalite, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.modalite, {
                                'attr': {
                                    'class': 'mission-control'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.modalite) }}
                            </div>

                        </div>

                    </div>

                </section>

                <section class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-calendar3"></i>
                        </div>

                        <div>
                            <h2 class="section-title">
                                Calendrier de la mission
                            </h2>

                            <p class="section-description">
                                Définissez les principales échéances.
                            </p>
                        </div>

                    </div>

                    <div class="field-grid">

                        <div class="field-group">

                            {{ form_label(form.dateDebutSouhaitee, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.dateDebutSouhaitee, {
                                'attr': {
                                    'class': 'mission-control'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.dateDebutSouhaitee) }}
                            </div>

                        </div>

                        <div class="field-group">

                            {{ form_label(form.dureeEstimee, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.dureeEstimee, {
                                'attr': {
                                    'class': 'mission-control',
                                    'placeholder': 'Ex. 3 semaines'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.dureeEstimee) }}
                            </div>

                        </div>

                    </div>

                    <div class="field-group mt-4">

                        {{ form_label(form.dateLimiteReponse, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        {{ form_widget(form.dateLimiteReponse, {
                            'attr': {
                                'class': 'mission-control',
                                'aria-describedby': 'mission-help-deadline'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.dateLimiteReponse) }}
                        </div>

                        <p class="field-help" id="mission-help-deadline">
                            La date limite doit être future.
                            Elle est obligatoire pour soumettre la mission.
                        </p>

                    </div>

                </section>

                <section class="form-section">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="bi bi-cash-coin"></i>
                        </div>

                        <div>
                            <h2 class="section-title">
                                Tarification de la mission
                            </h2>

                            <p class="section-description">
                                Indiquez la fourchette tarifaire proposée
                                pour cette prestation. Ces informations
                                sont facultatives.
                            </p>
                        </div>

                    </div>

                    <div class="field-grid">

                        <div class="field-group">

                            {{ form_label(form.budgetMin, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.budgetMin, {
                                'attr': {
                                    'class': 'mission-control',
                                    'placeholder': 'Ex. 300'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.budgetMin) }}
                            </div>

                        </div>

                        <div class="field-group">

                            {{ form_label(form.budgetMax, null, {
                                'label_attr': {
                                    'class': 'field-label'
                                }
                            }) }}

                            {{ form_widget(form.budgetMax, {
                                'attr': {
                                    'class': 'mission-control',
                                    'placeholder': 'Ex. 500'
                                }
                            }) }}

                            <div class="form-errors">
                                {{ form_errors(form.budgetMax) }}
                            </div>

                        </div>

                    </div>

                    <div class="field-group mt-4">

                        {{ form_label(form.uniteBudget, null, {
                            'label_attr': {
                                'class': 'field-label'
                            }
                        }) }}

                        {{ form_widget(form.uniteBudget, {
                            'attr': {
                                'class': 'mission-control'
                            }
                        }) }}

                        <div class="form-errors">
                            {{ form_errors(form.uniteBudget) }}
                        </div>

                    </div>

                    <div class="budget-note">

                        <i class="bi bi-info-circle"></i>

                        <div>
                            Le tarif peut être horaire, journalier ou forfaitaire.
                            Si vous renseignez une fourchette de tarifs,
                            le montant minimum ne peut pas dépasser
                            le montant maximum.
                        </div>

                    </div>

                </section>

                <section class="form-actions">

                    <h2 class="actions-title">
                        Enregistrer votre mission
                    </h2>

                    <p class="actions-description">
                        Enregistrez votre travail pour le compléter plus tard,
                        ou soumettez votre mission à l'équipe GNUT06
                        pour vérification.
                    </p>

                    <div class="actions-buttons">

                        {{ form_widget(form.saveDraft, {
                            'attr': {
                                'class': 'mission-btn mission-btn-outline'
                            }
                        }) }}

                        {{ form_widget(form.submitForReview, {
                            'attr': {
                                'class': 'mission-btn mission-btn-primary'
                            }
                        }) }}

                    </div>

                </section>

            </div>

            <aside class="form-sidebar">

                <div class="sidebar-card sidebar-card-highlight">

                    <div class="sidebar-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <h3 class="sidebar-title">
                        Conseils de rédaction
                    </h3>

                    <ul class="sidebar-list">

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>
                                Utilisez un titre précis qui décrit
                                clairement la prestation.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>
                                Présentez les objectifs et les
                                livrables attendus.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>
                                Précisez les compétences
                                nécessaires à la réalisation.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-check-circle"></i>
                            <span>
                                Indiquez une date limite
                                réaliste.
                            </span>
                        </li>

                    </ul>

                </div>

                <div class="sidebar-card">

                    <div class="sidebar-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h3 class="sidebar-title">
                        Comment ça fonctionne ?
                    </h3>

                    <ul class="sidebar-list">

                        <li>
                            <i class="bi bi-1-circle"></i>
                            <span>
                                Vous préparez votre mission
                                et l'enregistrez.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-2-circle"></i>
                            <span>
                                Vous la soumettez à
                                validation.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-3-circle"></i>
                            <span>
                                L'équipe GNUT06 examine
                                son contenu.
                            </span>
                        </li>

                        <li>
                            <i class="bi bi-4-circle"></i>
                            <span>
                                Après validation, elle devient
                                visible dans l'annuaire.
                            </span>
                        </li>

                    </ul>

                    <div class="sidebar-divider"></div>

                    <div class="sidebar-alert">

                        <i class="bi bi-lock"></i>

                        <span>
                            Une mission enregistrée n'est
                            pas automatiquement publiée.
                        </span>

                    </div>

                </div>

                <div class="sidebar-card">

                    <div class="sidebar-icon">
                        <i class="bi bi-eye"></i>
                    </div>

                    <h3 class="sidebar-title">
                        Confidentialité
                    </h3>

                    <p class="sidebar-text">
                        Les informations de votre mission
                        pourront être consultées publiquement
                        après validation.
                    </p>

                    <div class="sidebar-divider"></div>

                    <p class="sidebar-text">
                        Ne renseignez aucune coordonnée
                        personnelle ni donnée sensible dans
                        le titre ou la description.
                    </p>

                </div>

            </aside>

        </div>

        {{ form_end(form) }}

    </div>

</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const page = document.querySelector('.mission-form-page');

    if (!page) {
        return;
    }

    const select = page.querySelector('[data-skill-select]');
    const selectedList = page.querySelector('[data-selected-skill-list]');
    const selectedCount = page.querySelector('[data-selected-skill-count]');
    const emptyMessage = page.querySelector('[data-selected-skill-empty]');

    if (!select || !selectedList || !selectedCount || !emptyMessage) {
        return;
    }

    function updateSelectedCompetences() {
        const selectedOptions = Array.from(select.selectedOptions);

        selectedList.replaceChildren();

        selectedCount.textContent =
            selectedOptions.length +
            ' sélectionnée' +
            (selectedOptions.length > 1 ? 's' : '');

        emptyMessage.hidden = selectedOptions.length > 0;

        selectedOptions.forEach(function (option) {
            const tag = document.createElement('span');
            tag.className = 'selected-skill-tag';

            const label = document.createElement('span');
            label.textContent = option.textContent.trim();

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'selected-skill-remove';
            removeButton.textContent = '×';

            removeButton.setAttribute(
                'aria-label',
                'Retirer la compétence ' + option.textContent.trim()
            );

            removeButton.addEventListener('click', function () {
                option.selected = false;

                select.dispatchEvent(
                    new Event('change', {
                        bubbles: true
                    })
                );

                select.focus();
            });

            tag.appendChild(label);
            tag.appendChild(removeButton);

            selectedList.appendChild(tag);
        });
    }

    select.addEventListener('change', updateSelectedCompetences);

    updateSelectedCompetences();
});
</script>

{% endblock %}