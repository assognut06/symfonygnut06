{% extends 'base.html.twig' %}

{% block title %}Mes missions | GNUT 06{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
        <div>
            <h1 class="mb-1">Mes missions</h1>
            <p class="text-muted mb-0">{{ compte.raisonSociale }}</p>
        </div>
        <a class="btn btn-primary" href="{{ path('entreprise_mission_new') }}">Créer une mission</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    {% if missions is empty %}
        <div class="alert alert-info">Vous n'avez pas encore créé de mission.</div>
    {% else %}
        <div class="row g-3">
            {% for mission in missions %}
                <div class="col-12">
                    <article class="card shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <h2 class="h5 mb-2">{{ mission.titre ?: 'Mission sans titre' }}</h2>
                                <p class="mb-1"><span class="badge bg-secondary">{{ mission.statut|replace({'_': ' '})|capitalize }}</span></p>
                                <p class="text-muted mb-0">Créée le {{ mission.createdAt|date('d/m/Y') }}</p>
                            </div>
                            {% if mission.statut in editableStatuses %}
                                <a class="btn btn-outline-primary" href="{{ path('entreprise_mission_edit', {id: mission.id}) }}">Modifier</a>
                            {% endif %}
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
