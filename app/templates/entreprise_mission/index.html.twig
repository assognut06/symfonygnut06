{% extends 'base.html.twig' %}

{% block title %}Mes missions | GNUT 06{% endblock %}

{% block body %}

{% set totalMissions = missions|length %}
{% set totalDrafts = 0 %}
{% set totalPending = 0 %}
{% set totalPublished = 0 %}

{% for mission in missions %}
    {% if mission.statut == 'brouillon' %}
        {% set totalDrafts = totalDrafts + 1 %}
    {% elseif mission.statut == 'en_attente' %}
        {% set totalPending = totalPending + 1 %}
    {% elseif mission.statut == 'publiee' %}
        {% set totalPublished = totalPublished + 1 %}
    {% endif %}
{% endfor %}

{% set statusLabels = {
    'brouillon': 'Brouillon',
    'en_attente': 'En attente de validation',
    'a_corriger': 'À corriger',
    'publiee': 'Publiée',
    'cloturee': 'Clôturée',
    'expiree': 'Expirée',
    'retiree': 'Retirée'
} %}

{% set modalityLabels = {
    'distance': 'À distance',
    'sur_place': 'Sur place',
    'hybride': 'Hybride'
} %}

<style>
    .mission-dashboard {
        min-height: 75vh;
        padding: 65px 0 100px;
        background:
            radial-gradient(
                ellipse at 85% 0%,
                rgba(139, 92, 246, 0.11),
                transparent 45%
            ),
            #060611;
        color: #f8f9ff;
    }

    .mission-dashboard .dashboard-container {
        max-width: 1250px;
        margin: 0 auto;
        padding: 0 25px;
    }

    .mission-dashboard .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 25px;
        margin-bottom: 40px;
    }

    .mission-dashboard .dashboard-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border-radius: 30px;
        background: rgba(153, 102, 255, 0.12);
        color: #c99aff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.3px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .mission-dashboard .dashboard-title {
        font-size: clamp(30px, 4vw, 46px);
        font-weight: 800;
        letter-spacing: -1.5px;
        color: #ffffff;
        margin-bottom: 10px;
    }

    .mission-dashboard .dashboard-subtitle {
        color: #a7a8bd;
        font-size: 15px;
        margin-bottom: 0;
    }

    .mission-dashboard .dashboard-subtitle strong {
        color: #d9b5ff;
        font-weight: 600;
    }

    .mission-dashboard .btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 24px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(
            135deg,
            #b45cf3,
            #6b6dff
        );
        color: white;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 8px 25px rgba(129, 91, 250, 0.2);
    }

    .mission-dashboard .btn-create:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 12px 35px rgba(129, 91, 250, 0.35);
    }

    .mission-dashboard .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 45px;
    }

    .mission-dashboard .stat-card {
        position: relative;
        overflow: hidden;
        padding: 25px;
        background: #111121;
        border: 1px solid #25253b;
        border-radius: 18px;
        transition: border-color 0.2s, transform 0.2s;
    }

    .mission-dashboard .stat-card:hover {
        border-color: #7155a5;
        transform: translateY(-3px);
    }

    .mission-dashboard .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: var(--stat-color);
    }

    .mission-dashboard .stat-total {
        --stat-color: #a879ff;
    }

    .mission-dashboard .stat-draft {
        --stat-color: #93a3c2;
    }

    .mission-dashboard .stat-pending {
        --stat-color: #f6bc64;
    }

    .mission-dashboard .stat-published {
        --stat-color: #4bd6a0;
    }

    .mission-dashboard .stat-label {
        color: #a4a5bc;
        font-size: 13px;
        margin-bottom: 15px;
        font-weight: 500;
    }

    .mission-dashboard .stat-value {
        color: #ffffff;
        font-size: 36px;
        font-weight: 800;
        line-height: 1;
        margin: 0;
    }

    .mission-dashboard .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 22px;
    }

    .mission-dashboard .section-title {
        font-size: 22px;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .mission-dashboard .section-count {
        background: #24243b;
        color: #c8c9e0;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .mission-dashboard .missions-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .mission-dashboard .mission-card {
        background: #111120;
        border: 1px solid #25253a;
        border-radius: 18px;
        padding: 26px;
        transition: border-color 0.2s, transform 0.2s;
    }

    .mission-dashboard .mission-card:hover {
        border-color: #655087;
        transform: translateY(-2px);
    }

    .mission-dashboard .mission-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 20px;
    }

    .mission-dashboard .mission-title {
        font-size: 20px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 10px;
    }

    .mission-dashboard .mission-description {
        color: #a4a5b8;
        line-height: 1.7;
        font-size: 14px;
        margin-bottom: 18px;
        max-width: 850px;
        overflow-wrap: anywhere;
    }

    .mission-dashboard .mission-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 22px;
        color: #a7a8bd;
        font-size: 13px;
    }

    .mission-dashboard .mission-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .mission-dashboard .mission-meta-item i {
        color: #aa83ee;
        font-size: 15px;
    }

    .mission-dashboard .mission-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .mission-dashboard .status-brouillon {
        background: rgba(148, 163, 184, 0.15);
        color: #cbd5e1;
    }

    .mission-dashboard .status-en_attente {
        background: rgba(245, 158, 11, 0.15);
        color: #fcd34d;
    }

    .mission-dashboard .status-a_corriger {
        background: rgba(249, 115, 22, 0.15);
        color: #fdba74;
    }

    .mission-dashboard .status-publiee {
        background: rgba(16, 185, 129, 0.15);
        color: #6ee7b7;
    }

    .mission-dashboard .status-cloturee {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
    }

    .mission-dashboard .status-expiree {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
    }

    .mission-dashboard .status-retiree {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
    }

    .mission-dashboard .mission-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid #29293b;
    }

    .mission-dashboard .mission-date {
        color: #85869f;
        font-size: 12px;
    }

    .mission-dashboard .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 18px;
        border-radius: 10px;
        background: rgba(167, 114, 255, 0.1);
        border: 1px solid #74549d;
        color: #dfbaff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s;
    }

    .mission-dashboard .btn-edit:hover {
        background: #74549d;
        color: white;
    }

    .mission-dashboard .mission-locked {
        color: #85869f;
        font-size: 12px;
    }

    .mission-dashboard .empty-state {
        text-align: center;
        padding: 75px 25px;
        background: #111120;
        border: 1px dashed #41415d;
        border-radius: 22px;
    }

    .mission-dashboard .empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(166, 101, 255, 0.12);
        color: #c18bff;
        font-size: 32px;
    }

    .mission-dashboard .empty-title {
        color: white;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .mission-dashboard .empty-description {
        color: #a4a5b8;
        font-size: 14px;
        line-height: 1.7;
        max-width: 450px;
        margin: 0 auto 25px;
    }

    .mission-dashboard .dashboard-alert {
        border-radius: 12px;
        padding: 15px 20px;
        margin-bottom: 20px;
        border: 1px solid;
        font-size: 14px;
    }

    .mission-dashboard .dashboard-alert-success {
        background: rgba(16, 185, 129, 0.1);
        color: #a7f3d0;
        border-color: rgba(16, 185, 129, 0.3);
    }

    .mission-dashboard .dashboard-alert-info {
        background: rgba(99, 102, 241, 0.1);
        color: #c7d2fe;
        border-color: rgba(99, 102, 241, 0.3);
    }

    .mission-dashboard .btn-create:focus-visible,
    .mission-dashboard .btn-edit:focus-visible {
        outline: 3px solid #ffffff;
        outline-offset: 3px;
    }

    @media (max-width: 992px) {
        .mission-dashboard .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 576px) {
        .mission-dashboard {
            padding: 35px 0 60px;
        }

        .mission-dashboard .dashboard-container {
            padding: 0 16px;
        }

        .mission-dashboard .dashboard-header {
            align-items: stretch;
        }

        .mission-dashboard .btn-create {
            width: 100%;
        }

        .mission-dashboard .stats-grid {
            gap: 12px;
        }

        .mission-dashboard .stat-card {
            padding: 20px 16px;
        }

        .mission-dashboard .stat-value {
            font-size: 29px;
        }

        .mission-dashboard .mission-card {
            padding: 20px 16px;
        }

        .mission-dashboard .mission-title {
            font-size: 18px;
        }

        .mission-dashboard .mission-card-footer {
            align-items: stretch;
        }

        .mission-dashboard .btn-edit {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<main class="mission-dashboard">

    <div class="dashboard-container">

        <header class="dashboard-header">

            <div>

                <div class="dashboard-label">
                    <i class="bi bi-grid-1x2-fill"></i>
                    Espace entreprise
                </div>

                <h1 class="dashboard-title">
                    Mes missions
                </h1>

                <p class="dashboard-subtitle">
                    Gérez les missions de
                    <strong>{{ compte.raisonSociale }}</strong>
                </p>

            </div>

            <a
                href="{{ path('entreprise_mission_new') }}"
                class="btn-create"
            >
                <i class="bi bi-plus-lg"></i>
                Créer une mission
            </a>

        </header>

        {% for message in app.flashes('success') %}

            <div class="dashboard-alert dashboard-alert-success" role="status">
                <i class="bi bi-check-circle me-2"></i>
                {{ message }}
            </div>

        {% endfor %}

        {% for message in app.flashes('info') %}

            <div class="dashboard-alert dashboard-alert-info" role="status">
                <i class="bi bi-info-circle me-2"></i>
                {{ message }}
            </div>

        {% endfor %}

        <section class="stats-grid" aria-label="Statistiques des missions">

            <div class="stat-card stat-total">

                <div class="stat-label">
                    Total des missions
                </div>

                <p class="stat-value">
                    {{ totalMissions }}
                </p>

            </div>

            <div class="stat-card stat-draft">

                <div class="stat-label">
                    Brouillons
                </div>

                <p class="stat-value">
                    {{ totalDrafts }}
                </p>

            </div>

            <div class="stat-card stat-pending">

                <div class="stat-label">
                    En attente
                </div>

                <p class="stat-value">
                    {{ totalPending }}
                </p>

            </div>

            <div class="stat-card stat-published">

                <div class="stat-label">
                    Publiées
                </div>

                <p class="stat-value">
                    {{ totalPublished }}
                </p>

            </div>

        </section>

        <section aria-labelledby="mission-list-title">

            <div class="section-header">

                <h2 class="section-title" id="mission-list-title">
                    Toutes mes missions
                </h2>

                <span class="section-count">
                    {{ totalMissions }}
                    mission{{ totalMissions > 1 ? 's' : '' }}
                </span>

            </div>

            {% if missions is empty %}

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>

                    <h3 class="empty-title">
                        Aucune mission pour le moment
                    </h3>

                    <p class="empty-description">
                        Vous n'avez pas encore créé de mission.
                        Commencez par déposer votre première mission
                        pour trouver les compétences adaptées à vos besoins.
                    </p>

                    <a
                        href="{{ path('entreprise_mission_new') }}"
                        class="btn-create"
                    >
                        <i class="bi bi-plus-lg"></i>
                        Créer ma première mission
                    </a>

                </div>

            {% else %}

                <div class="missions-list">

                    {% for mission in missions %}

                        {% set statusLabel = statusLabels[mission.statut] ?? mission.statut %}

                        <article class="mission-card">

                            <div class="mission-card-header">

                                <div>

                                    <h3 class="mission-title">
                                        {{ mission.titre ?: 'Mission sans titre' }}
                                    </h3>

                                    <span class="mission-badge status-{{ mission.statut }}">
                                        <i class="bi bi-circle-fill" style="font-size: 7px;"></i>
                                        {{ statusLabel }}
                                    </span>

                                </div>

                            </div>

                            {% if mission.description %}

                                <p class="mission-description">
                                    {{ mission.description|striptags|slice(0, 220) }}
                                    {% if mission.description|length > 220 %}
                                        ...
                                    {% endif %}
                                </p>

                            {% endif %}

                            <div class="mission-meta">

                                {% if mission.zone %}

                                    <span class="mission-meta-item">
                                        <i class="bi bi-geo-alt"></i>
                                        {{ mission.zone }}
                                    </span>

                                {% endif %}

                                {% if mission.modalite %}

                                    <span class="mission-meta-item">
                                        <i class="bi bi-laptop"></i>
                                        {{ modalityLabels[mission.modalite] ?? mission.modalite }}
                                    </span>

                                {% endif %}

                                {% if mission.dateLimiteReponse %}

                                    <span class="mission-meta-item">
                                        <i class="bi bi-calendar-event"></i>
                                        Limite :
                                        {{ mission.dateLimiteReponse|date('d/m/Y') }}
                                    </span>

                                {% endif %}

                                {% if mission.competences|length > 0 %}

                                    <span class="mission-meta-item">
                                        <i class="bi bi-stars"></i>
                                        {{ mission.competences|length }}
                                        compétence{{ mission.competences|length > 1 ? 's' : '' }}
                                    </span>

                                {% endif %}

                            </div>

                            <div class="mission-card-footer">

                                <span class="mission-date">
                                    <i class="bi bi-clock-history me-1"></i>
                                    Créée le {{ mission.createdAt|date('d/m/Y') }}
                                </span>

                                {% if mission.statut in editableStatuses %}

                                    <a
                                        href="{{ path('entreprise_mission_edit', {
                                            id: mission.id
                                        }) }}"
                                        class="btn-edit"
                                    >
                                        <i class="bi bi-pencil-square"></i>
                                        Modifier
                                    </a>

                                {% else %}

                                    <span class="mission-locked">
                                        <i class="bi bi-lock me-1"></i>
                                        Modification indisponible
                                    </span>

                                {% endif %}

                            </div>

                        </article>

                    {% endfor %}

                </div>

            {% endif %}

        </section>

    </div>

</main>

{% endblock %}