{% extends 'base.html.twig' %}

{% block title %}Mes missions | GNUT 06{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/01-core.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/shared/02-components.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-list/01-dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-list/02-table.css') }}">
    <link rel="stylesheet" href="{{ asset('css/gnut06/enterprise/mission-list/03-responsive.css') }}">
{% endblock %}

{% block body %}
{% set totalMissions = missions|length %}
{% set totalDrafts = 0 %}
{% set totalPending = 0 %}
{% set totalPublished = 0 %}
{% for mission in missions %}
    {% if mission.statut == 'brouillon' %}
        {% set totalDrafts = totalDrafts + 1 %}
    {% elseif mission.statut == 'en_attente' %}
        {% set totalPending = totalPending + 1 %}
    {% elseif mission.statut == 'publiee' %}
        {% set totalPublished = totalPublished + 1 %}
    {% endif %}
{% endfor %}
{% set statusLabels = {
    'brouillon': 'Brouillon',
    'en_attente': 'En attente de validation',
    'a_corriger': 'À corriger',
    'publiee': 'Publiée',
    'cloturee': 'Clôturée',
    'expiree': 'Expirée',
    'retiree': 'Retirée'
} %}
{% set modalityLabels = {'distance': 'À distance', 'sur_place': 'Sur place', 'hybride': 'Hybride'} %}

<main class="mission-dashboard">
    <div class="dashboard-container">
        <header class="dashboard-header">
            <div>
                <span class="dashboard-label"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Espace entreprise</span>
                <h1 class="dashboard-title">Mes missions</h1>
                <p class="dashboard-subtitle">Gérez les missions de <strong>{{ compte.raisonSociale }}</strong></p>
            </div>
            <a href="{{ path('entreprise_mission_new') }}" class="btn-create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Créer une mission</a>
        </header>

        {% for message in app.flashes('success') %}
            <div class="dashboard-alert dashboard-alert-success" role="status"><i class="bi bi-check-circle me-2" aria-hidden="true"></i>{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="dashboard-alert dashboard-alert-info" role="status"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>{{ message }}</div>
        {% endfor %}

        <section class="stats-grid" aria-label="Statistiques des missions">
            <div class="stat-card stat-total"><div class="stat-label">Total des missions</div><p class="stat-value">{{ totalMissions }}</p></div>
            <div class="stat-card stat-draft"><div class="stat-label">Brouillons</div><p class="stat-value">{{ totalDrafts }}</p></div>
            <div class="stat-card stat-pending"><div class="stat-label">En attente</div><p class="stat-value">{{ totalPending }}</p></div>
            <div class="stat-card stat-published"><div class="stat-label">Publiées</div><p class="stat-value">{{ totalPublished }}</p></div>
        </section>

        <section class="missions-section" aria-labelledby="mission-list-title">
            <div class="section-header">
                <h2 class="section-title" id="mission-list-title">Toutes mes missions</h2>
                <span class="section-count">{{ totalMissions }} mission{{ totalMissions > 1 ? 's' : '' }}</span>
            </div>
            {% if missions is empty %}
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></div>
                    <h3 class="empty-title">Aucune mission pour le moment</h3>
                    <p class="empty-description">Vous n'avez pas encore créé de mission. Commencez par déposer votre première mission.</p>
                    <a href="{{ path('entreprise_mission_new') }}" class="btn-create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Créer ma première mission</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mission-table">
                        <caption class="visually-hidden">Missions de votre entreprise avec leur statut, échéance et actions disponibles.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Mission</th>
                                <th scope="col">Localisation</th>
                                <th scope="col">Modalité</th>
                                <th scope="col">Date limite</th>
                                <th scope="col">Compétences</th>
                                <th scope="col">Création</th>
                                <th scope="col">Statut</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for mission in missions %}
                                {% set statusLabel = statusLabels[mission.statut] ?? mission.statut %}
                                <tr>
                                    <td>
                                        <span class="mission-name">{{ mission.titre ?: 'Mission sans titre' }}</span>
                                        {% if mission.description %}
                                            <span class="mission-excerpt">{{ mission.description|striptags|slice(0, 95) }}{% if mission.description|striptags|length > 95 %}…{% endif %}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ mission.zone ?: '—' }}</td>
                                    <td>{{ modalityLabels[mission.modalite] ?? (mission.modalite ?: '—') }}</td>
                                    <td class="text-nowrap">{{ mission.dateLimiteReponse ? mission.dateLimiteReponse|date('d/m/Y') : '—' }}</td>
                                    <td>{{ mission.competences|length }}</td>
                                    <td class="text-nowrap">{{ mission.createdAt|date('d/m/Y') }}</td>
                                    <td><span class="mission-badge status-{{ mission.statut }}"><i class="bi bi-circle-fill" aria-hidden="true"></i>{{ statusLabel }}</span></td>
                                    <td>
                                        {% if mission.statut in editableStatuses %}
                                            <a href="{{ path('entreprise_mission_edit', {'id': mission.id}) }}" class="btn-edit" aria-label="Modifier la mission {{ mission.titre ?: 'sans titre' }}"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
                                        {% else %}
                                            <span class="mission-locked"><i class="bi bi-lock me-1" aria-hidden="true"></i>Non modifiable</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}