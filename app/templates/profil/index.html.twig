{% extends 'base.html.twig' %}

{% block title %}{{ profileForm is defined and profileForm.vars.submitted and not profileForm.vars.valid ? 'Erreur : ' : '' }}Mon espace - GNUT 06{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('profil') }}
{% endblock %}

{% block body %}
    {% import 'profil/_fields.html.twig' as ui %}

    <nav aria-label="Navigation rapide" class="visually-hidden-focusable">
        <a href="#main-content" class="skip-link">Aller au contenu principal</a>
        <a href="#profile-nav" class="skip-link">Aller à la navigation de mon espace</a>
        <a href="#profile-content" class="skip-link">Aller au contenu de mon espace</a>
    </nav>

    {% set section = app.request.attributes.get('donnees') ?? (app.request.attributes.get('_route') == 'app_profil' ? 'profile' : '') %}
    {% set firstName = payer is defined and payer ? payer.firstName|trim : '' %}
    {% set tih = app.user ? app.user.tih : null %}
    {% set tihRejection = tih ? tih.latestRefusalEvent : null %}
    {% set tihReview = tih ? tih.latestReviewRequestEvent : null %}
    {% set isReview = tihReview and (not tihRejection or tihReview.occurredAt > tihRejection.occurredAt or (tihReview.occurredAt == tihRejection.occurredAt and tihReview.id > tihRejection.id)) %}
    {% set latestMessage = isReview ? tihReview : tihRejection %}
    {% set sections = [
        {key: 'profile', label: 'Profil', icon: 'person', url: path('app_profil')},
        {key: 'orders', label: 'Commandes', icon: 'bag', url: path('app_profil_page', {page: 1, donnees: 'orders'})},
        {key: 'payments', label: 'Paiements', icon: 'credit-card', url: path('app_profil_page', {page: 1, donnees: 'payments'})},
    ] %}

    <div class="account-page">
        <main id="main-content" class="account-panel" aria-labelledby="account-title">

            <section class="account-hero">
                <img class="account-hero__photo"
                     src="{{ asset('images/webp/LSCA_mars2025.webp') }}"
                     alt=""
                     width="1200" height="900">

                <div class="account-hero__intro">
                    <div class="account-avatar">
                        {% if user.profilePicture %}
                            <img src="{{ asset('uploads/profilePictures/' ~ user.profilePicture) }}"
                                 class="account-avatar__img"
                                 alt="Votre photo de profil">
                        {% else %}
                            <img src="{{ asset('images/user_profil.jpg') }}"
                                 class="account-avatar__img"
                                 alt="Photo de profil par défaut">
                        {% endif %}
                        <a href="{{ path('edit_profile_picture') }}"
                           class="account-avatar__edit"
                           aria-label="{{ user.profilePicture ? 'Modifier' : 'Ajouter' }} votre photo de profil">
                            <i class="bi bi-camera" aria-hidden="true"></i>
                        </a>
                    </div>

                    <div class="account-hero__text">
                        <h1 id="account-title" class="account-hero__title">
                            Bienvenue{{ firstName ? ', ' ~ firstName : '' }}
                        </h1>
                        <p class="account-hero__lead">
                            Content de vous revoir. Ici, vous gérez vos informations, vos commandes et vos dons.
                        </p>
                        <p class="account-hero__meta">
                            {{ user.email }}
                            · {{ user.isVerified ? 'Email vérifié' : 'Email non vérifié' }}
                            · Identifiant : {{ user.id }}
                        </p>
                        {% if user.profilePicture %}
                            <form method="post"
                                  action="{{ path('delete_profile_picture') }}"
                                  class="account-hero__remove"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre photo de profil ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_profile_picture' ~ user.id) }}">
                                <button type="submit" class="account-hero__remove-btn">Supprimer la photo</button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                <nav class="account-hero__links" aria-label="Raccourcis de l'association">
                    <a href="{{ path('app_billetteries') }}">Réserver une activité</a>
                    <a href="{{ path('app_metavers') }}">Salles 3D immersives</a>
                    <a href="{{ path('app_don') }}">Soutenir l'association</a>
                </nav>
            </section>

            <div class="account-body">
                <nav id="profile-nav" class="account-nav" aria-label="Sections de mon espace">
                    <ul class="account-nav__list">
                        {% for item in sections %}
                            <li>
                                <a href="{{ item.url }}"
                                   class="account-nav__link{{ section == item.key ? ' is-active' : '' }}"
                                   {% if section == item.key %}aria-current="page"{% endif %}>
                                    <i class="bi bi-{{ item.icon }}" aria-hidden="true"></i>
                                    {{ item.label }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="account-nav__actions">
                        <a href="{{ path('app_logout') }}" class="account-btn account-btn--quiet account-nav__logout">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            Se déconnecter
                        </a>
                    </div>
                </nav>

                <div id="profile-content" class="account-content">

                    {% if latestMessage and tih.applicationStatus != constant('App\\Entity\\Tih::STATUS_APPROVED') %}
                        {% set isPending = tih.applicationStatus == constant('App\\Entity\\Tih::STATUS_PENDING') %}
                        {% if not isReview or isPending %}
                            <div class="alert alert-warning account-alert" role="status">
                                <span>{{ isReview ? 'Votre profil TIH est en attente de validation. Vous avez un nouveau message.' : 'Vous avez un message concernant votre candidature TIH.' }}</span>
                            </div>
                        {% endif %}
                        <section id="tih-review-message" class="account-card account-card--notice" tabindex="-1" aria-labelledby="tih-review-title">
                            <h2 id="tih-review-title" class="account-card__title text-{{ isReview ? 'warning' : 'danger' }}">
                                {{ isReview ? (isPending ? 'Votre profil TIH est de nouveau en attente de validation' : 'Message précédent concernant votre profil TIH') : 'Refus de votre candidature TIH' }}
                            </h2>
                            <p class="account-card__hint">Message reçu le {{ latestMessage.occurredAt|date('d/m/Y à H:i') }}</p>
                            <p class="account-notice__label">{{ isReview ? 'Motif de la remise en attente :' : 'Motif du refus :' }}</p>
                            <p class="account-notice__reason">{{ latestMessage.reason }}</p>
                        </section>
                    {% endif %}

                    {% if section == 'profile' %}

                        {% if not user.isVerified %}
                            <div class="alert alert-warning" role="alert">
                                <p class="mb-2">Votre adresse email n'est pas encore vérifiée.</p>
                                <a href="{{ path('app_verify_email_renew', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                                    Renvoyer l'email de confirmation
                                </a>
                            </div>
                        {% endif %}

                        {% if profileForm is defined %}
                            <section class="account-card" aria-labelledby="profile-form-title">
                                <h2 id="profile-form-title" class="account-card__title">Informations personnelles</h2>
                                <p class="account-card__hint">Utilisées pour vos commandes et vos reçus de don.</p>

                                {{ form_start(profileForm, {
                                    action: path('app_profil'),
                                    method: 'POST',
                                    attr: profileForm.vars.attr|merge({'data-profile-unsaved': profileForm.vars.submitted and not profileForm.vars.valid ? 'true' : 'false'})
                                }) }}
                                    {% include 'profil/_error_summary.html.twig' with {form: profileForm} only %}
                                    <div class="account-form-grid">
                                        {{ ui.field(profileForm.firstName) }}
                                        {{ ui.field(profileForm.lastName) }}
                                        {{ ui.field(profileForm.address) }}
                                        {{ ui.field(profileForm.zipCode) }}
                                        {{ ui.field(profileForm.city) }}
                                        {{ ui.field(profileForm.phone) }}
                                    </div>
                                    <div class="account-form-footer">
                                        <p id="form-help" class="account-form-footer__note">
                                            <span class="account-required" aria-hidden="true">*</span> Champ obligatoire
                                        </p>
                                        <p class="account-form-status" data-profile-status role="status" {% if not profileForm.vars.submitted or profileForm.vars.valid %}hidden{% endif %}>Modifications non enregistrées</p>
                                        <button type="submit" class="account-btn account-btn--primary">Enregistrer</button>
                                    </div>
                                {{ form_end(profileForm) }}
                            </section>
                        {% endif %}

                    {% elseif section == 'orders' %}
                        <section class="account-card" aria-labelledby="orders-title">
                            <h2 id="orders-title" class="account-card__title">Mes commandes</h2>
                            {% if data_items.loadFailed|default(false) %}
                                {% include 'profil/_history_unavailable.html.twig' with {section: section, page: app.request.attributes.get('page')|default(1)} only %}
                            {% elseif data_items is defined and data_items['data'] is not empty %}
                                <div class="account-list" role="list" aria-label="Liste de vos commandes">
                                    {% for item in data_items['data'] %}
                                        <div class="account-list__item" role="listitem">
                                            {% include 'profil/orders.html.twig' %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="account-empty" role="status">
                                    <i class="bi bi-bag" aria-hidden="true"></i>
                                    <p>Aucune commande à afficher pour le moment.</p>
                                    <a href="{{ path('app_billetteries') }}" class="account-btn account-btn--outline">Réserver une activité</a>
                                </div>
                            {% endif %}
                        </section>

                    {% elseif section == 'payments' %}
                        <section class="account-card" aria-labelledby="payments-title">
                            <h2 id="payments-title" class="account-card__title">Mes paiements</h2>
                            {% if data_items.loadFailed|default(false) %}
                                {% include 'profil/_history_unavailable.html.twig' with {section: section, page: app.request.attributes.get('page')|default(1)} only %}
                            {% elseif data_items is defined and data_items['data'] is not empty %}
                                <div class="account-list" role="list" aria-label="Liste de vos paiements">
                                    {% for item in data_items['data'] %}
                                        <div class="account-list__item" role="listitem">
                                            {% include 'profil/payments.html.twig' %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="account-empty" role="status">
                                    <i class="bi bi-credit-card" aria-hidden="true"></i>
                                    <p>Aucun paiement à afficher pour le moment.</p>
                                </div>
                            {% endif %}
                        </section>
                    {% endif %}

                    {% if section in ['orders', 'payments'] and not data_items.loadFailed|default(false) %}
                        {% include 'profil/_pagination.html.twig' with {
                            pagination: data_items.pagination|default({}),
                            section: section
                        } only %}
                    {% endif %}

                    {% include 'profil/_connected_accounts.html.twig' with {user: user} only %}
                    {% include 'profil/_tih_space.html.twig' with {tih: tih} only %}

                </div>
            </div>
        </main>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('profil') }}
{% endblock %}
