{% extends 'base.html.twig' %}

{% block title %}Confirmer la liaison OAuth - GNUT 06{% endblock %}

{% block body %}
    <main class="container py-5" style="max-width: 560px">
        <h1 class="h3">Confirmer la liaison {{ provider.value == 'google' ? 'Google' : 'Microsoft' }}</h1>
        <p>Pour protéger votre compte, confirmez votre identité avant de continuer vers le fournisseur OAuth.</p>

        <form method="post" action="{{ path('oauth_link_authorize', {provider: provider.value}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('oauth_link_authorize_' ~ provider.value) }}">
            <div class="mb-3">
                <label class="form-label" for="oauth-link-password">Mot de passe actuel</label>
                <input class="form-control" id="oauth-link-password" name="password" type="password" autocomplete="current-password" required>
            </div>
            <button class="btn btn-primary" type="submit">Continuer avec le mot de passe</button>
        </form>

        <p class="mt-4">Ou confirmez votre identité avec une connexion déjà liée.</p>
        <div class="d-flex gap-2 flex-wrap">
                {% if user.googleId and provider.value != 'google' %}
                    <form method="post" action="{{ path('oauth_link_provider_reauth', {provider: provider.value, reauthenticationProvider: 'google'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('oauth_link_provider_reauth_' ~ provider.value ~ '_google') }}">
                        <button class="btn btn-outline-danger" type="submit">Continuer avec Google</button>
                    </form>
                {% endif %}
                {% if user.azureId and provider.value != 'microsoft' %}
                    <form method="post" action="{{ path('oauth_link_provider_reauth', {provider: provider.value, reauthenticationProvider: 'microsoft'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('oauth_link_provider_reauth_' ~ provider.value ~ '_microsoft') }}">
                        <button class="btn btn-outline-primary" type="submit">Continuer avec Microsoft</button>
                    </form>
                {% endif %}
        </div>
        <a class="btn btn-link mt-3" href="{{ path('app_profil') }}">Annuler</a>
    </main>
{% endblock %}
